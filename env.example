SUPABASE_API_KEY=xxxxxxxxxxxxxxxxxxx
SUPABASE_URL=https://xxxx.supabase.co
OLLAMA_LLM_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBEDDINGS_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text

# Optional — used only by `npm run eval` (scripts/eval.ts). A separate, ideally larger, model
# to judge answers with raglens, so it isn't the same model that generated them (self-judging
# bias). Falls back to OLLAMA_LLM_MODEL when unset.
OLLAMA_JUDGE_MODEL=gemma3:4b

# LangFuse — optional, tracing is skipped when these are absent
# Get keys from: https://cloud.langfuse.com → Project Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASEURL=https://cloud.langfuse.com
